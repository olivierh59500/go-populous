# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Previous code
previous/

# Go workspace file
go.work
go.work.sum

# env file
.env

# .DS_Store
.DS_Store

# Android local configuration and build products
android/.gradle/
android/build/
android/app/build/
android/app/libs/*.aar
android/app/libs/*-sources.jar
android/local.properties
android/keystore/
/dist/android/*
!/dist/android/SHA256SUMS
!/dist/android/populous-android-1.1.0-arm64.apk

# Current portable Windows release (all other generated releases stay local)
/dist/windows/*
!/dist/windows/SHA256SUMS
!/dist/windows/populous-windows-x86-1.1.0.exe
!/dist/windows/populous-windows-x64-1.1.0.exe
!/dist/windows/populous-windows-arm64-1.1.0.exe

# Generated demo movies and export scratch files
/recordings/

# Per-device mobile controls and display preferences
/go-populous-ui.json

# Editor/IDE
# .idea/
# .vscode/

.gitignore
docs/*
!docs/ANDROID_BLUETOOTH.md
!docs/WINDOWS_RELEASE.md
